# ================ OS 自动生成垃圾文件（不要传） ================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# ================ IDE / 编辑器配置（个人本地，不要传） ================
.idea/
*.iml
*.iws
*.ipr
.vscode/
.vs/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ================ 环境 / 依赖 / 缓存（不要传） ================
# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Node.js（本项目无依赖，留作兜底）
node_modules/
package-lock.json
yarn.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ================ 本地运行日志 / 临时文件 ================
*.log
*.tmp
*.temp
*.bak
